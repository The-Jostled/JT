{#- Step diagram + stepper.
    Inputs (from the page, or set before including): attackPath, category.
    Optional: apBase (URL prefix for links, used when previewing a writeup on
    another page) and apCompact (diagram only, no detail panels).
    The SVG is rendered twice: left-to-right for wide screens, top-to-bottom
    under 40rem. CSS shows one; the other is display:none. -#}
{%- set apLabel = "Investigation path" if category == "Defense" else "Attack path" -%}
{%- set apBase = apBase or "" -%}
{%- set n = attackPath | length -%}
{%- set hw = 136 -%}{%- set hh = 76 -%}{%- set hgap = 26 -%}
{%- set hW = n * hw + (n - 1) * hgap + 4 -%}
{%- set vw = 300 -%}{%- set vh = 44 -%}{%- set vgap = 18 -%}
{%- set vH = n * vh + (n - 1) * vgap + 4 -%}
<nav class="attack-path cat-{{ category | lower }}" aria-label="{{ apLabel }}" data-attack-path>
  <p class="ap-title" aria-hidden="true">{{ apLabel }}</p>
  <div class="ap-scroll">
    <svg class="ap ap-h" viewBox="0 0 {{ hW }} {{ hh + 4 }}" width="{{ hW }}" height="{{ hh + 4 }}" style="max-width:{{ hW }}px;min-width:{{ (hW * 0.8) | round }}px">
      <title>{{ apLabel }}: {{ n }} steps</title>
      {%- for step in attackPath %}
      {%- set x = 2 + loop.index0 * (hw + hgap) -%}
      {%- set lines = step.label | wrapLabel(19) -%}
      {%- set ty = 51 - ((lines | length) - 1) * 7.5 %}
      <a class="ap-node" href="{{ apBase }}#{{ step.anchor }}" data-step="{{ loop.index0 }}">
        <rect x="{{ x }}" y="2" width="{{ hw }}" height="{{ hh }}" rx="8"/>
        <text class="ap-num" x="{{ x + 10 }}" y="18" aria-hidden="true">{{ loop.index }}</text>
        <text class="ap-label" text-anchor="middle" y="{{ ty }}">{% for l in lines %}<tspan x="{{ x + hw / 2 }}"{% if not loop.first %} dy="15"{% endif %}>{{ l }}{% if not loop.last %} {% endif %}</tspan>{% endfor %}</text>
      </a>
      {%- if not loop.last %}
      <path class="ap-line" data-after="{{ loop.index0 }}" d="M{{ x + hw + 4 }} {{ 2 + hh / 2 }}h{{ hgap - 15 }}"/>
      <path class="ap-head" data-after="{{ loop.index0 }}" d="M{{ x + hw + hgap - 12 }} {{ hh / 2 - 3 }}l9 5l-9 5z"/>
      {%- endif %}
      {%- endfor %}
    </svg>
    <svg class="ap ap-v" viewBox="0 0 {{ vw + 4 }} {{ vH }}" width="{{ vw + 4 }}" height="{{ vH }}" style="max-width:{{ vw + 4 }}px">
      <title>{{ apLabel }}: {{ n }} steps</title>
      {%- for step in attackPath %}
      {%- set y = 2 + loop.index0 * (vh + vgap) -%}
      {%- set lines = step.label | wrapLabel(40) -%}
      {%- set ty = y + vh / 2 + 4 - ((lines | length) - 1) * 7.5 %}
      <a class="ap-node" href="{{ apBase }}#{{ step.anchor }}" data-step="{{ loop.index0 }}">
        <rect x="2" y="{{ y }}" width="{{ vw }}" height="{{ vh }}" rx="8"/>
        <text class="ap-num" x="14" y="{{ y + vh / 2 + 4 }}" aria-hidden="true">{{ loop.index }}</text>
        <text class="ap-label" y="{{ ty }}">{% for l in lines %}<tspan x="34"{% if not loop.first %} dy="15"{% endif %}>{{ l }}{% if not loop.last %} {% endif %}</tspan>{% endfor %}</text>
      </a>
      {%- if not loop.last %}
      <path class="ap-line" data-after="{{ loop.index0 }}" d="M{{ 2 + vw / 2 }} {{ y + vh + 3 }}v{{ vgap - 12 }}"/>
      <path class="ap-head" data-after="{{ loop.index0 }}" d="M{{ vw / 2 - 3 }} {{ y + vh + vgap - 10 }}l5 8l5 -8z"/>
      {%- endif %}
      {%- endfor %}
    </svg>
  </div>
  {%- if not apCompact %}
  {#- One panel per step. Without JS they are all listed; site.js turns them
      into a stepper that shows the selected step only. #}
  <ol class="ap-steps" data-ap-steps>
    {%- for step in attackPath %}
    {%- set i = loop.index %}
    <li class="ap-step" id="ap-step-{{ i }}" data-label="{{ step.label }}"{% if step.access %} data-access="{{ step.access }}"{% endif %}>
      <p class="ap-step-head">
        <span class="ap-step-n">Step {{ i }} of {{ n }}</span>
        <span class="ap-meter" aria-hidden="true">{% for s in attackPath %}<span{% if loop.index <= i %} class="on"{% endif %}></span>{% endfor %}</span>
      </p>
      <h2 class="ap-step-title">{{ step.label }}</h2>
      <dl class="ap-facts">
        {%- if step.access %}
        <div><dt>Access after this step</dt><dd><strong>{{ step.access }}</strong></dd></div>
        {%- endif %}
        {%- if step.technique %}
        <div><dt>ATT&amp;CK</dt><dd><span class="mono">{{ step.technique }}</span> {{ step.technique | techniqueName }}</dd></div>
        {%- endif %}
        {%- if step.command %}
        <div class="ap-wide"><dt>Key command</dt><dd><code>{{ step.command }}</code></dd></div>
        {%- endif %}
        {%- if step.detect %}
        <div class="ap-wide ap-defend"><dt>What a defender would see</dt><dd>{{ step.detect }}</dd></div>
        {%- endif %}
        {%- if step.finding %}
        <div class="ap-wide ap-defend"><dt>What this established</dt><dd>{{ step.finding }}</dd></div>
        {%- endif %}
      </dl>
      <p class="ap-step-foot"><a href="#{{ step.anchor }}">Read this step in full ↓</a></p>
    </li>
    {%- endfor %}
  </ol>
  {#- Slim bar that follows you down the page. Hidden until site.js shows it. #}
  <div class="ap-progress" data-ap-progress hidden>
    <div class="wrap">
      <ol class="ap-progress-segs">
        {%- for step in attackPath %}
        <li><a href="#{{ step.anchor }}" title="Step {{ loop.index }}: {{ step.label }}"><span class="sr-only">Step {{ loop.index }}: {{ step.label }}</span></a></li>
        {%- endfor %}
      </ol>
      <p class="ap-progress-label" data-ap-progress-label></p>
    </div>
  </div>
  {%- endif %}
</nav>
