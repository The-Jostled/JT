{#- Card for a writeup, project or post. Set `showAttack` before including to
    list each writeup's ATT&CK technique IDs on the card. -#}
{%- set isWriteup = item.data.section == "writeups" -%}
<li class="card{% if item.data.category %} cat-{{ item.data.category | lower }}{% endif %}"{% if isWriteup and item.data.attack %} data-attack="{{ item.data.attack | join(' ') }}"{% endif %}{% if item.data.platform %} data-platform="{{ item.data.platform }}"{% endif %}{% if item.data.os %} data-os="{{ item.data.os }}"{% endif %}{% if item.data.difficulty %} data-difficulty="{{ item.data.difficulty }}"{% endif %}>
  <a href="{{ item.url }}">
    <h3>{{ item.data.title }}</h3>
    <p>{{ item.data.summary }}</p>
    <p class="card-meta">
      {% if item.data.category %}<span class="cat-pill">{{ item.data.category }}</span> {% endif %}{% if item.data.platform %}{{ item.data.platform }} · {% endif %}{% if item.data.difficulty %}{{ item.data.difficulty }} · {% endif %}{% if item.data.os %}{{ item.data.os }} · {% endif %}<time datetime="{{ item.date | isoDate }}">{{ item.date | readableDate }}</time>
    </p>
    {%- if showAttack and isWriteup and item.data.attack %}
    <p class="card-attack"><span class="sr-only">ATT&amp;CK techniques: </span>{% for id in item.data.attack %}<span class="card-tech" data-technique="{{ id }}">{{ id }}</span>{% endfor %}</p>
    {%- endif %}
  </a>
</li>
