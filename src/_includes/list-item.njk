<li class="card">
  <a href="{{ item.url | url }}">
    <h3>{{ item.data.title }}</h3>
    <p>{{ item.data.summary }}</p>
    <p class="card-meta">
      {% if item.data.platform %}{{ item.data.platform }} · {% endif %}{% if item.data.difficulty %}{{ item.data.difficulty }} · {% endif %}{% if item.data.os %}{{ item.data.os }} · {% endif %}<time datetime="{{ item.date | isoDate }}">{{ item.date | readableDate }}</time>
    </p>
  </a>
</li>
