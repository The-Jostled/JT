---
layout: base.njk
---
<article class="post">
  <header class="post-header">
    {% if section %}<p class="eyebrow"><a href="{{ ('/' + section + '/') }}">{{ section | capitalize }}</a></p>{% endif %}
    <h1>{{ title }}</h1>
    {% if summary %}<p class="lede">{{ summary }}</p>{% endif %}
    <dl class="meta">
      {% if platform %}<div><dt>Platform</dt><dd>{{ platform }}</dd></div>{% endif %}
      {% if difficulty %}<div><dt>Difficulty</dt><dd>{{ difficulty }}</dd></div>{% endif %}
      {% if os %}<div><dt>OS</dt><dd>{{ os }}</dd></div>{% endif %}
      {% if category %}<div class="cat-{{ category | lower }}"><dt>Category</dt><dd><span class="cat-pill">{{ category }}</span></dd></div>{% endif %}
      <div><dt>Date</dt><dd><time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time></dd></div>
    </dl>
    {% if tags %}<ul class="tags">{% for t in tags %}<li>{{ t }}</li>{% endfor %}</ul>{% endif %}
  </header>
  {% if attackPath %}{% include "attack-path.njk" %}{% endif %}
  {%- set hasGlance = section == "writeups" and (ports or cves or tools) %}
  <div class="post-body{% if hasGlance %} has-glance{% endif %}">
    {%- if hasGlance %}
    <aside class="glance" aria-labelledby="glance-title">
      <h2 id="glance-title">At a glance</h2>
      <dl>
        {%- if ports %}
        <div><dt>Open ports</dt><dd><ul class="tags">{% for p in ports %}<li>{{ p }}</li>{% endfor %}</ul></dd></div>
        {%- endif %}
        {%- if cves %}
        <div><dt>CVEs</dt><dd><ul class="cve-list">{% for c in cves %}<li><a href="https://nvd.nist.gov/vuln/detail/{{ c.id }}">{{ c.id }}</a> <span class="sev sev-{{ c.severity | lower }}">{{ c.severity }}</span></li>{% endfor %}</ul></dd></div>
        {%- endif %}
        {%- if tools %}
        <div><dt>Tools</dt><dd><ul class="tags">{% for t in tools %}<li>{{ t }}</li>{% endfor %}</ul></dd></div>
        {%- endif %}
      </dl>
    </aside>
    {%- endif %}
    <div class="prose">
      {{ content | safe }}
    </div>
  </div>
</article>
